# LSBATCH: User input
#!/usr/bin/env bash
#==============================================================================
# LSF Job: Phase 5a — QSage Training
#
# Compiles all QProfiler results from the sweep and trains a QSage
# meta-model (XGBoost-Optuna) with SHAP analysis.
#
# Run AFTER job_02_qprofiler_array.sh completes.
#
# Submit from repo root:
#   bsub < experiments/admet_benchmark/lsf/job_03_qsage.sh
#
# Estimated wall time: ~2 h (Optuna 200 trials × all model combinations)
#==============================================================================

#BSUB -J admet_qsage
#BSUB -q normal
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8000]"
#BSUB -W 04:00
#BSUB -o logs/admet/qsage_%J.out
#BSUB -e logs/admet/qsage_%J.err
#BSUB -cwd /proj/bmfm/users/bckwon/projects/QBioCode

set -euo pipefail

REPO_ROOT="/proj/bmfm/users/bckwon/projects/QBioCode"
PYTHON="${REPO_ROOT}/.venv/bin/python"
LOG_DIR="${REPO_ROOT}/logs/admet"

mkdir -p "${LOG_DIR}"

echo "======================================================"
echo "Job ID     : ${LSB_JOBID:-local}"
echo "Host       : $(hostname)"
echo "Start time : $(date)"
echo "======================================================"

cd "${REPO_ROOT}"

${PYTHON} experiments/admet_benchmark/03_train_qsage_admet.py \
    --results-dir   results/admet_benchmark \
    --output-dir    results/admet_benchmark/sage \
    --sage-type     xgboost_optuna \
    --n-iter        200 \
    --cv            10 \
    --test-size     0.2 \
    --seed          42 \
    2>&1 | tee "${LOG_DIR}/qsage_${LSB_JOBID:-local}.log"

